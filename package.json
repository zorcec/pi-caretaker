{
  "name": "pi-caretaker",
  "version": "0.1.1",
  "description": "Native Pi extension: webhooks in, agent triage, Telegram only when it matters",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Tomislav Zorcec",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zorcec/pi-caretaker.git"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "webhook",
    "caretaker"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsup",
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "prestart": "pnpm build",
    "send:alert": "node scripts/send-alert.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit --project guards",
    "test:e2e": "vitest run --project build --project e2e",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "lint:symbols": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "release": "node scripts/release.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "grammy": "^1.46.0",
    "typebox": "^1.4.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.7.0",
    "vitest": "^3.0.0"
  }
}
